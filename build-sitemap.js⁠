const fs = require('fs');
const path = require('path');

const SITE_URL = "https://dailyglamstore.in";

// 1. Core Static Pages (beauty-guides.html removed)
const staticPages = [
  { url: "/", priority: "1.0", changefreq: "daily" },
  { url: "/shop.html", priority: "0.9", changefreq: "daily" },
  { url: "/beauty-blog.html", priority: "0.8", changefreq: "weekly" },
  { url: "/share-feedback/", priority: "0.5", changefreq: "monthly" }
];

// 2. Parse ARTICLE_REGISTRY safely from article-registry.js
function getArticleRegistry() {
  const registryPath = path.join(__dirname, "article-registry.js");
  if (!fs.existsSync(registryPath)) {
    throw new Error("article-registry.js file not found!");
  }
  const fileContent = fs.readFileSync(registryPath, "utf8");
  const match = fileContent.match(/window\.ARTICLE_REGISTRY\s*=\s*({[\s\S]*?});/);
  if (!match) {
    throw new Error("Could not parse ARTICLE_REGISTRY from article-registry.js");
  }
  return eval(`(${match[1]})`);
}

// 3. Extract exact dateModified / date / url from individual article JS files
function getArticleMetaData(categoryFolder, slug) {
  const possiblePaths = [
    path.join(__dirname, `${categoryFolder}-articles`, `${slug}.js`),
    path.join(__dirname, "articles", categoryFolder, `${slug}.js`),
    path.join(__dirname, `${slug}.js`)
  ];

  let filePath = possiblePaths.find(p => fs.existsSync(p));
  if (!filePath) return null;

  try {
    const fileContent = fs.readFileSync(filePath, "utf8");
    
    const dateModifiedMatch = fileContent.match(/dateModified\s*:\s*["']([^"']+)["']/);
    const dateMatch = fileContent.match(/date\s*:\s*["']([^"']+)["']/);
    const urlMatch = fileContent.match(/url\s*:\s*["']([^"']+)["']/);

    let rawDate = dateModifiedMatch ? dateModifiedMatch[1] : (dateMatch ? dateMatch[1] : null);
    let formattedDate = rawDate ? rawDate.split('T')[0] : null;

    return {
      date: formattedDate,
      canonicalPath: urlMatch ? urlMatch[1] : null
    };
  } catch (err) {
    return null;
  }
}

// 4. Build XML Sitemap
function buildSitemap() {
  const registry = getArticleRegistry();
  const fallbackDate = new Date().toISOString().split('T')[0];

  let xml = `<?xml version="1.0" encoding="UTF-8"?>\n`;
  xml += `<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n`;

  // Add Static Pages
  staticPages.forEach(page => {
    xml += `  <url>\n`;
    xml += `    <loc>${SITE_URL}${page.url}</loc>\n`;
    xml += `    <lastmod>${fallbackDate}</lastmod>\n`;
    xml += `    <changefreq>${page.changefreq}</changefreq>\n`;
    xml += `    <priority>${page.priority}</priority>\n`;
    xml += `  </url>\n`;
  });

  // Process Category Articles
  const processCategory = (categoryName, pathSegment) => {
    const slugs = registry[categoryName] || [];
    slugs.forEach(slug => {
      const meta = getArticleMetaData(pathSegment, slug);
      const lastmod = (meta && meta.date) ? meta.date : fallbackDate;
      const urlPath = (meta && meta.canonicalPath) 
        ? meta.canonicalPath 
        : `/articles/${pathSegment}/${slug}.html`;

      xml += `  <url>\n`;
      xml += `    <loc>${SITE_URL}${urlPath.startsWith('/') ? '' : '/'}${urlPath}</loc>\n`;
      xml += `    <lastmod>${lastmod}</lastmod>\n`;
      xml += `    <changefreq>weekly</changefreq>\n`;
      xml += `    <priority>0.7</priority>\n`;
      xml += `  </url>\n`;
    });
  };

  processCategory("skincare", "skincare");
  processCategory("haircare", "haircare");

  xml += `</urlset>`;

  const outputPath = path.join(__dirname, "sitemap.xml");
  fs.writeFileSync(outputPath, xml, "utf8");
  console.log(`\n✅ sitemap.xml generated successfully at: ${outputPath}\n`);
}

buildSitemap();

