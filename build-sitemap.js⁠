const fs = require('fs');
const path = require('path');

const SITE_URL = "https://dailyglamstore.in";

// 1. Static Pages Configuration
const staticPages = [
  { url: "/", priority: "1.0", changefreq: "daily" },
  { url: "/shop.html", priority: "0.9", changefreq: "daily" },
  { url: "/beauty-blog.html", priority: "0.8", changefreq: "weekly" },
  { url: "/share-feedback/", priority: "0.5", changefreq: "monthly" }
];

// Helper to safely extract date/canonical URL from any article .js file
function getArticleMetaData(filePath) {
  if (!fs.existsSync(filePath)) return null;

  try {
    const fileContent = fs.readFileSync(filePath, "utf8");
    
    const dateModifiedMatch = fileContent.match(/dateModified\s*:\s*["']([^"']+)["']/);
    const dateMatch = fileContent.match(/date\s*:\s*["']([^"']+)["']/);
    const urlMatch = fileContent.match(/url\s*:\s*["']([^"']+)["']/);

    let rawDate = dateModifiedMatch ? dateModifiedMatch[1] : (dateMatch ? dateMatch[1] : null);
    let formattedDate = rawDate ? rawDate.split('T')[0] : null;

    return {
      date: formattedDate,
      canonicalPath: urlMatch ? urlMatch[1] : null
    };
  } catch (err) {
    return null;
  }
}

// Safely parse article-registry.js
function getRegistrySlugs() {
  const registryPath = path.join(__dirname, "article-registry.js");
  if (!fs.existsSync(registryPath)) return [];

  try {
    const content = fs.readFileSync(registryPath, "utf8");
    const matches = content.match(/["']([a-zA-Z0-0-_\/]+)["']/g);
    if (!matches) return [];
    return matches.map(m => m.replace(/["']/g, ''));
  } catch (err) {
    return [];
  }
}

// Helper to scan all .html files across subdirectories
function getAllHtmlFiles(dirPath, arrayOfFiles = []) {
  if (!fs.existsSync(dirPath)) return arrayOfFiles;
  const files = fs.readdirSync(dirPath);

  files.forEach(file => {
    const fullPath = path.join(dirPath, file);
    if (file.startsWith('.') || file === 'node_modules') return;

    if (fs.statSync(fullPath).isDirectory()) {
      getAllHtmlFiles(fullPath, arrayOfFiles);
    } else if (file.endsWith('.html')) {
      arrayOfFiles.push(fullPath);
    }
  });

  return arrayOfFiles;
}

function buildSitemap() {
  const rootDir = __dirname;
  const fallbackDate = new Date().toISOString().split('T')[0];
  const urlSet = new Map(); // Using Map to avoid duplicate entries

  // 1. Add Static Core Pages
  staticPages.forEach(page => {
    urlSet.set(page.url, {
      loc: `${SITE_URL}${page.url}`,
      lastmod: fallbackDate,
      changefreq: page.changefreq,
      priority: page.priority
    });
  });

  // 2. Scan and Add All HTML Files (Articles & Subpages)
  const allHtmlFiles = getAllHtmlFiles(rootDir);

  allHtmlFiles.forEach(filePath => {
    let relativePath = path.relative(rootDir, filePath).replace(/\\/g, '/');

    // Skip utility pages
    if (relativePath === '404.html' || relativePath === 'admin-tools.html') return;

    let cleanUrlPath = relativePath === 'index.html' ? '/' : `/${relativePath}`;
    if (urlSet.has(cleanUrlPath)) return; // Skip if already added as a static core page

    // Check if there is a corresponding JS file for metadata
    let jsFilePath = filePath.replace(/\.html$/, '.js');
    let meta = getArticleMetaData(jsFilePath);

    const fileStats = fs.statSync(filePath);
    const fileLastMod = fileStats.mtime.toISOString().split('T')[0];

    const lastmod = (meta && meta.date) ? meta.date : (fileLastMod || fallbackDate);
    const finalUrl = (meta && meta.canonicalPath) ? meta.canonicalPath : cleanUrlPath;

    urlSet.set(finalUrl, {
      loc: `${SITE_URL}${finalUrl.startsWith('/') ? '' : '/'}${finalUrl}`,
      lastmod: lastmod,
      changefreq: relativePath.includes('articles/') ? "weekly" : "monthly",
      priority: relativePath.includes('articles/') ? "0.8" : "0.6"
    });
  });

  // 3. Build XML String
  let xml = `<?xml version="1.0" encoding="UTF-8"?>\n`;
  xml += `<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n`;

  urlSet.forEach(item => {
    xml += `  <url>\n`;
    xml += `    <loc>${item.loc}</loc>\n`;
    xml += `    <lastmod>${item.lastmod}</lastmod>\n`;
    xml += `    <changefreq>${item.changefreq}</changefreq>\n`;
    xml += `    <priority>${item.priority}</priority>\n`;
    xml += `  </url>\n`;
  });

  xml += `</urlset>`;

  const outputPath = path.join(rootDir, "sitemap.xml");
  fs.writeFileSync(outputPath, xml, "utf8");
  console.log(`\n✅ sitemap.xml generated with ${urlSet.size} total URLs at: ${outputPath}\n`);
}

buildSitemap();
