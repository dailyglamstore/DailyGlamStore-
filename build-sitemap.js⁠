const fs = require('fs');
const path = require('path');
const vm = require('vm');

const SITE_URL = "https://dailyglamstore.in";

// 1. Core Static Pages
const staticPages = [
  { url: "/", priority: "1.0", changefreq: "daily" },
  { url: "/shop.html", priority: "0.9", changefreq: "daily" },
  { url: "/beauty-blog.html", priority: "0.8", changefreq: "weekly" },
  { url: "/share-feedback/", priority: "0.5", changefreq: "monthly" }
];

// Helper to safely load ARTICLE_REGISTRY using Node.js VM context
function loadArticleRegistry() {
  const registryPath = path.join(__dirname, "article-registry.js");
  if (!fs.existsSync(registryPath)) {
    console.warn("⚠️ article-registry.js not found!");
    return {};
  }

  try {
    const fileContent = fs.readFileSync(registryPath, "utf8");
    const sandbox = { window: {} };
    vm.createContext(sandbox);
    vm.runInContext(fileContent, sandbox);
    return sandbox.window.ARTICLE_REGISTRY || {};
  } catch (err) {
    console.error("⚠️ Failed to parse ARTICLE_REGISTRY:", err.message);
    return {};
  }
}

// Helper to extract date and canonical URL from article metadata files
function getArticleMetaData(category, slug) {
  const possiblePaths = [
    path.join(__dirname, `${category}-articles`, `${slug}.js`),
    path.join(__dirname, "articles", category, `${slug}.js`),
    path.join(__dirname, `${slug}.js`)
  ];

  const filePath = possiblePaths.find(p => fs.existsSync(p));
  if (!filePath) return null;

  try {
    const fileContent = fs.readFileSync(filePath, "utf8");
    
    const dateModifiedMatch = fileContent.match(/dateModified\s*:\s*["']([^"']+)["']/);
    const dateMatch = fileContent.match(/date\s*:\s*["']([^"']+)["']/);
    const urlMatch = fileContent.match(/url\s*:\s*["']([^"']+)["']/);

    let rawDate = dateModifiedMatch ? dateModifiedMatch[1] : (dateMatch ? dateMatch[1] : null);
    let formattedDate = rawDate ? rawDate.split('T')[0] : null;

    return {
      date: formattedDate,
      canonicalPath: urlMatch ? urlMatch[1] : null
    };
  } catch (err) {
    return null;
  }
}

function buildSitemap() {
  const fallbackDate = new Date().toISOString().split('T')[0];
  const urlSet = new Map();

  // Step A: Add Core Static Pages
  staticPages.forEach(page => {
    urlSet.set(page.url, {
      loc: `${SITE_URL}${page.url}`,
      lastmod: fallbackDate,
      changefreq: page.changefreq,
      priority: page.priority
    });
  });

  // Step B: Load Article Registry & Add Dynamic Article Pages
  const registry = loadArticleRegistry();

  Object.keys(registry).forEach(category => {
    const slugs = registry[category];
    if (!Array.isArray(slugs)) return;

    slugs.forEach(slug => {
      const meta = getArticleMetaData(category, slug);
      const lastmod = (meta && meta.date) ? meta.date : fallbackDate;
      
      // Default URL pattern if canonical path isn't specified in article file
      let relativeUrl = (meta && meta.canonicalPath) 
        ? meta.canonicalPath 
        : `/articles/${category}/${slug}.html`;

      if (!relativeUrl.startsWith('/')) {
        relativeUrl = '/' + relativeUrl;
      }

      urlSet.set(relativeUrl, {
        loc: `${SITE_URL}${relativeUrl}`,
        lastmod: lastmod,
        changefreq: "weekly",
        priority: "0.8"
      });
    });
  });

  // Step C: Build XML
  let xml = `<?xml version="1.0" encoding="UTF-8"?>\n`;
  xml += `<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n`;

  urlSet.forEach(item => {
    xml += `  <url>\n`;
    xml += `    <loc>${item.loc}</loc>\n`;
    xml += `    <lastmod>${item.lastmod}</lastmod>\n`;
    xml += `    <changefreq>${item.changefreq}</changefreq>\n`;
    xml += `    <priority>${item.priority}</priority>\n`;
    xml += `  </url>\n`;
  });

  xml += `</urlset>`;

  const outputPath = path.join(__dirname, "sitemap.xml");
  fs.writeFileSync(outputPath, xml, "utf8");
  console.log(`✅ Success! sitemap.xml updated with ${urlSet.size} total URLs.`);
}

buildSitemap();
