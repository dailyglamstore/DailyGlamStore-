const fs = require('fs');
const path = require('path');

const SITE_URL = "https://dailyglamstore.in";

// Helper to recursively find all .html files
function getAllHtmlFiles(dirPath, arrayOfFiles = []) {
  const files = fs.readdirSync(dirPath);

  files.forEach(file => {
    const fullPath = path.join(dirPath, file);
    // Ignore node_modules, .git, and build system files
    if (file.startsWith('.') || file === 'node_modules') return;

    if (fs.statSync(fullPath).isDirectory()) {
      getAllHtmlFiles(fullPath, arrayOfFiles);
    } else if (file.endsWith('.html')) {
      arrayOfFiles.push(fullPath);
    }
  });

  return arrayOfFiles;
}

function buildSitemap() {
  const rootDir = __dirname;
  const htmlFiles = getAllHtmlFiles(rootDir);
  const fallbackDate = new Date().toISOString().split('T')[0];

  let xml = `<?xml version="1.0" encoding="UTF-8"?>\n`;
  xml += `<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n`;

  htmlFiles.forEach(filePath => {
    // Convert local file system path into relative web URL
    let relativePath = path.relative(rootDir, filePath).replace(/\\/g, '/');
    
    // Ignore utility or admin pages if needed
    if (relativePath === 'admin-tools.html' || relativePath === '404.html') return;

    // Formatting root index.html as '/'
    let urlPath = relativePath === 'index.html' ? '' : `/${relativePath}`;

    // Get last modified date from git / file stats
    const stats = fs.statSync(filePath);
    const lastmod = stats.mtime.toISOString().split('T')[0] || fallbackDate;

    // Assign priorities
    let priority = "0.7";
    let changefreq = "weekly";

    if (relativePath === 'index.html' || relativePath === 'shop.html') {
      priority = "1.0";
      changefreq = "daily";
    } else if (relativePath.includes('articles/')) {
      priority = "0.8";
    }

    xml += `  <url>\n`;
    xml += `    <loc>${SITE_URL}${urlPath}</loc>\n`;
    xml += `    <lastmod>${lastmod}</lastmod>\n`;
    xml += `    <changefreq>${changefreq}</changefreq>\n`;
    xml += `    <priority>${priority}</priority>\n`;
    xml += `  </url>\n`;
  });

  xml += `</urlset>`;

  const outputPath = path.join(rootDir, "sitemap.xml");
  fs.writeFileSync(outputPath, xml, "utf8");
  console.log(`✅ Fully populated sitemap.xml created with ${htmlFiles.length} pages!`);
}

buildSitemap();
